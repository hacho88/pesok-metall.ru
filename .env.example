# PostgreSQL (пример: postgresql://user:password@localhost:5432/pesok_metall)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pesok_metall?schema=public"

# DeepSeek API (OpenAI-совместимый клиент)
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Секрет для защиты cron-эндпоинта автопилота
CRON_SECRET="change-me"

# Базовый домен (для middleware и генерации ссылок)
NEXT_PUBLIC_SITE_URL="https://pesok-metall.ru"

# Разрешённые origin для CORS админ-API (через запятую)
ADMIN_ORIGIN="http://localhost:3001"

# Секрет для токена предпросмотра Atlas (редактор → витрина)
PREVIEW_SECRET="change-me-preview"
